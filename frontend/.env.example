# ---------------------------------------------------------------------------
# AADRIQUE frontend — copy to frontend/.env and fill in.
#
# Create React App inlines REACT_APP_* variables at BUILD time. Changing one
# requires a rebuild; setting it at container runtime has no effect.
# ---------------------------------------------------------------------------

# Base URL of the API, WITHOUT the trailing /api and without a trailing slash.
#   local dev  : http://localhost:8000
#   docker      : http://localhost:8000
#   production : https://api.aadrique.in
#
# Leave blank to call the same origin the site is served from — correct when a
# reverse proxy forwards /api to the backend (the setup in nginx.conf).
REACT_APP_BACKEND_URL=http://localhost:8000

# Canonical public site URL, used for canonical links and OG tags.
REACT_APP_SITE_URL=https://www.aadrique.in

# Silence CRA build warnings-as-errors in CI (leave as-is).
CI=false
