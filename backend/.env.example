# ---------------------------------------------------------------------------
# AADRIQUE API — copy to backend/.env and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# --- Database (required) ---------------------------------------------------
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongo:27017
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=aadrique

# --- CORS (required in production) -----------------------------------------
# Exact browser origins allowed to call this API. Comma-separated, no trailing slash.
# Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000

# --- Admin API (required in production) ------------------------------------
# Guards GET /api/enquiries, which returns stored customer personal data.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank in development to disable the endpoint entirely.
ADMIN_TOKEN=

# --- Transactional email (optional) ----------------------------------------
# Without these, enquiries are still stored — no notification emails are sent.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=AADRIQUE
OWNER_EMAIL=info@aadrique.in
EMAIL_BASE_URL=https://integrations.emergentagent.com

# --- Networking ------------------------------------------------------------
# Set to true ONLY when the API sits behind a reverse proxy you control
# (nginx, Cloudflare, ALB). It makes the rate limiter trust X-Forwarded-For;
# enabling it on a directly exposed API lets clients spoof their IP.
TRUST_PROXY=false

# --- Contact form rate limit ----------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=60

# --- Seeding ---------------------------------------------------------------
# Re-seeds CMS content when seed_data.py's SEED_VERSION changes.
SEED_ON_STARTUP=true
